# Portul serverului
PORT=3100

# Conexiunea PostgreSQL (obligatorie). Local o scrie „npm run db:setup” (serviciul PostgreSQL instalat)
# sau „npm run dev:db” (un server PostgreSQL doar pentru dezvoltare, în data/pg, pe portul 5433).
DATABASE_URL=postgres://porumbar:parola@localhost:5432/porumbar

# Directorul datelor (poze)
DATA_DIR=./data

# Adresa publică permanentă (domeniul din codurile QR și din linkurile din emailuri)
PUBLIC_BASE_URL=http://localhost:3100

# Trimiterea emailurilor (parolă, invitații, amintiri). Fără server de email, apar doar în consola serverului.
# Fie separat (parola se lipește exact cum e): 465 = SSL/TLS, 587 = STARTTLS; expeditorul implicit e SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# … fie într-un singur rând (parola cu semne speciale trebuie codificată): smtps://utilizator:parola@server:465
SMTP_URL=
MAIL_FROM=

# Citirea pedigree-urilor din poză / PDF (Claude). Fără cheie, butonul „Citește din poză” spune că nu e pornit.
# Cheia se face în console.anthropic.com → API Keys. Costul îl plătește contul cheii.
ANTHROPIC_API_KEY=
# Câte citiri poate face un cont într-o zi (ca să nu explodeze costul).
PEDIGREE_READS_PER_DAY=20

# Consola vânzătorului: singurul admin. Contul se face la pornirea serverului din aceste două setări (formularul de
# cont nou refuză acest email). Parola de aici e doar pentru prima intrare: apoi schimb-o cu „Am uitat parola”.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cum te contactează crescătorii pentru plată și activare (apare în mesaje și în emailul de memento).
SELLER_CONTACT=

# În spatele unui proxy (Railway, Render): 1. Altfel toți utilizatorii par să vină de la aceeași adresă și limitele
# (încercări de intrare, link public) se aplică tuturor deodată.
TRUST_PROXY=

# Notificările pe telefon (amintirile de la tratamente). Cheile VAPID se fac o singură dată cu
# „npx web-push generate-vapid-keys”; fără ele, notificările pe telefon nu pornesc (amintirile vin doar pe email).
# VAPID_SUBJECT: un email al tău, în forma mailto:adresa@exemplu.ro (gol = fără notificări pe telefon)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Câte emailuri de amintire pleacă pe minut (ca serverul de email să nu ne blocheze).
REMINDER_EMAILS_PER_MINUTE=10

# Plata online prin Polar (merchant of record: Polar vinde, încasează, plătește TVA-ul și dă chitanța).
# Fără toate trei (token, produs, secret), butonul „Plătește” nu apare și abonamentele se activează de mână, ca acum.
# POLAR_ENV: sandbox (de probă, carduri de test) sau production. Tokenul și secretul le pune doar vânzătorul.
POLAR_ENV=sandbox
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# Parola copiilor de siguranță (consola vânzătorului → Copie de siguranță): cu ea se criptează fișierul descărcat și se
# deschide la restaurare. Cel puțin 12 caractere; fără ea, copia nu se face. O pune doar vânzătorul și o notează bine.
BACKUP_PASSPHRASE=
