{
  "name": "porumbar",
  "version": "0.1.0",
  "description": "Pigeonrama – evidența porumbeilor, pedigree și genealogie pentru columbofili",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "dev:web": "npm --prefix web start",
    "build": "npm --prefix web run build",
    "test": "node scripts/test.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "seed:exemplu": "node scripts/seed-exemplu.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "libphonenumber-js": "^1.13.17",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "web-push": "4.0.0"
  }
}
